name: telco-churn-mlproject
conda_env: conda.yaml

entry_points:
  main:
    parameters:
      train_data: {type: str, default: "telco_churn_preprocessing/train.csv"}
      test_data: {type: str, default: "telco_churn_preprocessing/test.csv"}
      n_estimators: {type: int, default: 200}
      max_depth: {type: int, default: 10}
    command: "python modelling.py --train_data {train_data} --test_data {test_data} --n_estimators {n_estimators} --max_depth {max_depth}"
